<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.lgtu.xarxes.ModsContainerController">

    <!-- Верхняя панель -->
    <top>
        <VBox spacing="10">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Collections" />
                <Label fx:id="resultsLabel" text="0 results" />
            </HBox>

            <HBox spacing="10">

                <TextField fx:id="searchField" promptText="Search collections..." HBox.hgrow="ALWAYS" />

                <Button text="🔍" />
            <Button fx:id="debugButton" onAction="#handleDebug" text="+" />

                <Region HBox.hgrow="ALWAYS" />

                <ComboBox fx:id="sortComboBox" promptText="All time" />
            <ComboBox fx:id="sortComboBox1" promptText="B" />
            </HBox>

        </VBox>
    </top>

    <!-- Список модов -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="transparent">

            <!-- Сюда будешь добавлять карточки -->
            <TilePane fx:id="modsContainer" hgap="15.0" prefColumns="0" prefRows="0" prefTileHeight="540.0" prefTileWidth="320.0" vgap="20.0">
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding></TilePane>

        </ScrollPane>
    </center>
   <padding>
      <Insets left="10.0" right="10.0" top="10.0" />
   </padding>

</BorderPane>
