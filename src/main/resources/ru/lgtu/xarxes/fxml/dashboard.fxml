<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="800.0" minWidth="1500.0" pannable="true" styleClass="transparent" vbarPolicy="NEVER" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.lgtu.xarxes.DashboardController">
   <content>
      <VBox fx:id="contentContainer" alignment="TOP_CENTER" spacing="40.0" style="-fx-background-color: rgba(0,0,0,0);" styleClass="transparent">
         <children>
            <StackPane minHeight="360.0" minWidth="1400.0" styleClass="promo-banner">
               <children>
                  <AnchorPane>
                     <children>
                        <HBox alignment="CENTER" layoutX="45.0" layoutY="287.0" prefHeight="50.0" prefWidth="325.0" spacing="25.0">
                           <children>
                              <Button fx:id="hermaeusButton" mnemonicParsing="false" onAction="#handleSwitchToHermaeus" prefHeight="50.0" prefWidth="150.0" styleClass="primary-button" text="Browse" />
                              <Button mnemonicParsing="false" prefHeight="50.0" prefWidth="150.0" styleClass="secondary-button" text="Oghma" />
                           </children>
                        </HBox>
                        <Label layoutX="45.0" layoutY="27.0" prefHeight="50.0" prefWidth="244.0" text="И вновь прекрасный день!" />
                     </children>
                  </AnchorPane>
               </children>
            </StackPane>
            <VBox>
               <children>
                  <HBox>
                     <children>
                        <Label text="Последние игры" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Посмотреть все" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="20.0">
                     <children>
                        <VBox alignment="CENTER" prefHeight="80.0" prefWidth="80.0" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="5.0" right="10.0" top="10.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>
            <VBox>
               <children>
                  <Label text="Новости" />
                  <HBox minHeight="80.0" minWidth="10.0" />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>
      </VBox>
   </content>
</ScrollPane>
