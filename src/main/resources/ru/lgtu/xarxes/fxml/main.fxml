<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Main Content -->

<BorderPane id="mainRoot" maxHeight="1080.0" maxWidth="1920.0" minHeight="720.0" minWidth="1280.0" prefHeight="900.0" prefWidth="1600.0" styleClass="main" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.lgtu.xarxes.MainController">

                          <!-- SIDEBAR -->
     <left>
         <VBox fx:id="sideBar" alignment="CENTER" prefWidth="100.0" spacing="10.0" styleClass="sidebar">
   
                                     <padding>
                 <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
             </padding>
         <children>
            <Button fx:id="homeButton" minHeight="40.0" minWidth="40.0" mnemonicParsing="false" prefHeight="60.0" prefWidth="60.0" />
            <ScrollPane fx:id="gamesScrollPane" hbarPolicy="NEVER" maxWidth="60.0" minHeight="60.0" minWidth="60.0" prefHeight="60.0" prefWidth="60.0" styleClass="gamesScrollPane" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="gamesContainer" alignment="CENTER" fillWidth="false" prefWidth="60.0" spacing="10.0">
                     <children>
                        <Button fx:id="addGameButton" contentDisplay="CENTER" maxHeight="60.0" maxWidth="60.0" mnemonicParsing="false" prefHeight="60.0" prefWidth="60.0">
                           <graphic>
                              <ImageView fitHeight="60.0" fitWidth="60.0" nodeOrientation="INHERIT" pickOnBounds="true" preserveRatio="true" />
                           </graphic>
                        </Button>
                     </children>
                  </VBox>
               </content>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </ScrollPane>
            <Button fx:id="downloadsButton" mnemonicParsing="false" prefHeight="60.0" prefWidth="60.0" />
         </children>
   
                                 </VBox>
     </left>
   <center>
      <BorderPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <top>
            <HBox fx:id="mainHeader" alignment="CENTER" onMouseDragged="#handleMouseDragged" onMousePressed="#handleMousePressed" prefHeight="80.0" prefWidth="200.0" spacing="10.0" styleClass="mainHeader" BorderPane.alignment="CENTER">
               <children>
                  <Region HBox.hgrow="ALWAYS" />
      
                                                              <!-- Search -->
                       <TextField fx:id="mainSearchField" prefHeight="40.0" prefWidth="400.0" promptText="Search mods, collections, authors..." styleClass="search-field">
                     <font>
                        <Font size="15.0" />
                     </font>
                  </TextField>
                  <StackPane fx:id="userControlArea" alignment="CENTER_RIGHT" />
                  <Separator orientation="VERTICAL" prefHeight="200.0" />
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Button fx:id="minimizeButton" minHeight="20.0" minWidth="20.0" mnemonicParsing="false" onAction="#handleMinimize" prefHeight="40.0" prefWidth="40.0" styleClass="windowButton" text="—" />
                        <Button fx:id="maximizeButton" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="20.0" minWidth="20.0" mnemonicParsing="false" onAction="#handleMaximize" prefHeight="40.0" prefWidth="40.0" styleClass="windowButton" text="□" />
                        <Button fx:id="closeButton" minHeight="20.0" minWidth="20.0" mnemonicParsing="false" onAction="#handleClose" prefHeight="40.0" prefWidth="40.0" styleClass="windowButton" text="✕" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="20.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
         </top>
         <center>
            <StackPane fx:id="contentArea" prefHeight="820.0" prefWidth="1500.0" BorderPane.alignment="CENTER">
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <BorderPane.margin>
                  <Insets />
               </BorderPane.margin></StackPane>
         </center>
      </BorderPane>
   </center>

                      </BorderPane>
